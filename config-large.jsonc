{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",

  "logo": {
    "source": "~/.config/fastfetch/logo.png",
    "height": 28,
    "padding": { "top": 1, "right": 5 }
  },

  "display": {
    "separator": " :  "
  },

  "modules": [
    {
      "type": "custom",
      "format": "\u001b[31m  \u001b[33m  \u001b[32m  \u001b[36m  \u001b[34m  \u001b[35m  \u001b[90m  \u001b[91m  \u001b[92m  \u001b[93m  \u001b[94m  \u001b[95m  \u001b[96m  \u001b[31m  \u001b[33m  \u001b[32m  \u001b[36m  \u001b[34m  \u001b[35m  \u001b[90m"
    },
    // ───────────────────────────── TITLE (WORKING) ─────────────────────────────
    {
  "type": "title",
  "key": "   \t\t\t",
  "format": "{6}{7}{8}"
},


{
  "type": "custom",
  "format": "\u001b[90m┌───────────────────────────────────────────────────────────────────┐"
},

// -------------------- DISTRO (CRITICAL) ---------------------
{
  "type": "command",
  "key": "              \u001b[31m󰣇 OS",
  "text": "echo Arch Linux"
},
{
  "type": "kernel",
  "key": "              \u001b[31m Kernel",
  "format": "{2}"
},
{
  "type": "packages",
  "key": "              \u001b[32m󰏗 Packages"
},
{
  "type": "shell",
  "key": "              \u001b[33m Shell"
},

{
  "type": "custom",
  "format": "\u001b[90m└───────────────────────────────────────────────────────────────────┘"
},

{
  "type": "command",
  "key": "\t\u001b[33m",
  "text": "splash=$(hyprctl splash);echo $splash"
},

{
  "type": "custom",
  "format": "\u001b[90m┌───────────────────────────────────────────────────────────────────┐"
},

// -------------------- UI / WM ---------------------
{
  "type": "wm",
  "key": "  \u001b[90m┌ \u001b[34m󱗃  UI/WM"
},
{
  "type": "wmtheme",
  "key": "  \u001b[90m│  ├ \u001b[34m󰉼"
},
{
  "type": "cursor",
  "key": "  \u001b[90m│  ├ \u001b[34m"
},
{
  "type": "terminalfont",
  "key": "  \u001b[90m│  ├ \u001b[34m"
},
{
  "type": "terminal",
  "key": "  \u001b[90m│  └ \u001b[34m"
},

// -------------------- SYSTEM ---------------------
{
  "type": "chassis",
  "key": "  \u001b[90m├ \u001b[32m󰌢  SYSTEM"
},
{
  "type": "cpu",
  "key": "  \u001b[90m│  ├ \u001b[32m CPU"
},
{
  "type": "gpu",
  "key": "  \u001b[90m│  ├ \u001b[32m󰊴 GPU",
  "format": "{2}"
},
{
  "type": "gpu",
  "key": "  \u001b[90m│  ├ \u001b[35m GPU Driver",
  "format": "{3}"
},
{
  "type": "command",
  "key": "  \u001b[90m│  ├ \u001b[32m󰍛 dGPU VRAM",
  "text": "best=$(for c in /sys/class/drm/card*/device; do [ -f \"$c/mem_info_vram_total\" ] && echo \"$(command cat \"$c/mem_info_vram_total\") $c\"; done | sort -nr | head -1 | cut -d' ' -f2); used=$(command cat \"$best/mem_info_vram_used\"); total=$(command cat \"$best/mem_info_vram_total\"); awk -v u=\"$used\" -v t=\"$total\" 'BEGIN{printf \"%.1f / %.1f GiB\", u/1073741824, t/1073741824}'"
},
{
  "type": "command",
  "key": "  \u001b[90m│  ├ \u001b[32m󰍛 iGPU VRAM",
  "text": "best=$(for c in /sys/class/drm/card*/device; do [ -f \"$c/mem_info_vram_total\" ] && echo \"$(command cat \"$c/mem_info_vram_total\") $c\"; done | sort -n | head -1 | cut -d' ' -f2); used=$(command cat \"$best/mem_info_vram_used\"); total=$(command cat \"$best/mem_info_vram_total\"); awk -v u=\"$used\" -v t=\"$total\" 'BEGIN{printf \"%.0f / %.0f MiB\", u/1048576, t/1048576}'"
},
{
  "type": "display",
  "key": "  \u001b[90m│  ├ \u001b[32m󰍹 Display",
  "format": "{1}x{2} @ {3}Hz [{7}]"
},
{
  "type": "memory",
  "key": "  \u001b[90m│  ├ \u001b[32m󰾆 RAM"
},
{
  "type": "swap",
  "key": "  \u001b[90m│  ├ \u001b[32m󰓡 SWAP"
},
{
  "type": "disk",
  "key": "  \u001b[90m│  ├ \u001b[32m󰋊 DISK"
},
{
  "type": "uptime",
  "key": "  \u001b[90m│  ├ \u001b[31m󱫐 Uptime "
},

// -------------------- AUDIO ---------------------
{
  "type": "sound",
  "key": "  \u001b[90m├ \u001b[35m  AUDIO",
  "format": "{2}"
},
{
  "type": "player",
  "key": "  \u001b[90m│  ├ \u001b[35m󰥠"
},
{
  "type": "media",
  "key": "  \u001b[90m│  └ \u001b[35m󰝚"
},

// -------------------- NETWORK ---------------------
{
  "type": "wifi",
  "key": "  \u001b[90m└ \u001b[36m󰤨  NETWORK"
},
// {
//   "type": "localip",
//   "key": "  \u001b[90m   ├ \u001b[36m󰩟"
// },
// {
//   "type": "publicip",
//   "key": "  \u001b[90m   └ \u001b[36m󰖟"
// },
// ----- Uncommented the above lines to show local and public IP -----

    {
      "type": "custom",
      "format": "\u001b[90m└───────────────────────────────────────────────────────────────────┘"
    },

    // ───────────────────────────── COLOR BAR ─────────────────────────────
    {
      "type": "custom",
      "format": "\u001b[31m  \u001b[33m  \u001b[32m  \u001b[36m  \u001b[34m  \u001b[35m  \u001b[90m  \u001b[91m  \u001b[92m  \u001b[93m  \u001b[94m  \u001b[95m  \u001b[96m  \u001b[31m  \u001b[33m  \u001b[32m  \u001b[36m  \u001b[34m  \u001b[35m  \u001b[90m"
    }

  ]
}
