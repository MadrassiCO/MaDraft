{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",

  "logo": {  
    "type": "auto",  
    "source": "~/.config/fastfetch/logo.png",    
    "height": 16,  
    "padding": {  
      "top": 1,  
      "right": 1 
    },  
    "position": "left"  
  },

  "display": {
    "separator": " :  "
  },

  "modules": [
    {
      "type": "custom",
      "format": "\u001b[31m  \u001b[33m  \u001b[32m  \u001b[36m  \u001b[34m  \u001b[35m  \u001b[90m  \u001b[91m  \u001b[92m  \u001b[93m  \u001b[94m  \u001b[95m  \u001b[96m  \u001b[31m  \u001b[33m"
    },
    
    // ───────────────────────────── TITLE (WORKING) ─────────────────────────────
    {
  "type": "title",
    "key": "󰀄",
    "format": "{6}{7}{8}"
},


{
  "type": "custom",
  "format": "\u001b[90m┌─────────────────────────────────────────┐"
},

// -------------------- DISTRO (CRITICAL) ---------------------
{
  "type": "command",
  "key": "\u001b[31m󰣇 OS",
  "text": "echo Arch Linux"
},
{
  "type": "kernel",
  "key": "\u001b[31m Kernel",
  "format": "{2}"
},
{
  "type": "packages",
  "key": "\u001b[32m󰏗 Packages"
},

{
  "type": "custom",
  "format": "\u001b[90m└─────────────────────────────────────────┘"
},

{
  "type": "command",
  "key": "\t\u001b[33m",
  "text": "splash=$(hyprctl splash);echo $splash"
},

{
  "type": "custom",
  "format": "\u001b[90m┌─────────────────────────────────────────┐"
},

// -------------------- UI / WM ---------------------
{
  "type": "wm",
  "key": "  \u001b[90m┌ \u001b[34m󱗃  UI/WM"
},

// -------------------- SYSTEM ---------------------
{
  "type": "chassis",
  "key": "  \u001b[90m├ \u001b[32m󰌢  SYSTEM"
},
{
  "type": "command",
  "key": "  \u001b[90m│  ├ \u001b[32m CPU",
  "text": "lscpu | awk -F: '/Model name/ {gsub(/^ +/,\"\",$2); sub(/Intel\\(R\\) Core\\(TM\\) /,\"\",$2); sub(/AMD Ryzen /,\"Ryzen \",$2); sub(/ CPU/,\"\",$2); print $2}'"
},
{
  "type": "gpu",
  "key": "  \u001b[90m│  ├ \u001b[32m󰊴 GPU",
  "format": "{2}"
},
{
  "type": "display",
  "key": "  \u001b[90m│  ├ \u001b[32m󰍹 Display",
  "format": "{1}×{2}@{3}"
},
{
  "type": "memory",
  "key": "  \u001b[90m│  ├ \u001b[32m󰾆 RAM"
},
{
  "type": "swap",
  "key": "  \u001b[90m│  ├ \u001b[32m󰓡 SWAP"
},
{
  "type": "command",
  "key": "  \u001b[90m│  ├ \u001b[32m󰋊 DISK",
  "text": "df -h / | awk 'NR==2 {print $3\" / \"$2\" (\"$5\")\"}'"
},

// -------------------NETWORK ---------------------
{
  "type": "command",
  "key": "  \u001b[90m└ \u001b[36m󰤨 NETWORK",
  "text": "awk 'NR==3{printf \"Wi-Fi (%d%%)\", int($3*100/70)}' /proc/net/wireless"
},

    {
      "type": "custom",
      "format": "\u001b[90m└─────────────────────────────────────────┘"
    },

    // ───────────────────────────── COLOR BAR ─────────────────────────────
    {
      "type": "custom",
      "format": "\u001b[31m  \u001b[33m  \u001b[32m  \u001b[36m  \u001b[34m  \u001b[35m  \u001b[90m  \u001b[91m  \u001b[92m  \u001b[93m  \u001b[94m  \u001b[95m  \u001b[96m  \u001b[31m  \u001b[33m"
    }
  ]
}
